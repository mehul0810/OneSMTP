{
  "name": "onesmtp",
  "version": "0.3.0",
  "private": true,
  "description": "Build tooling for the Aculect Mail WordPress plugin",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "wp-scripts build && cp node_modules/@wordpress/dataviews/build-style/style.css build/dataviews.css",
    "build:prod": "npm run build",
    "start": "wp-scripts start",
    "watch": "npm run start",
    "lint:js": "wp-scripts lint-js",
    "test:e2e": "playwright test --config=playwright.config.js",
    "ci": "npm run build"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@wordpress/api-fetch": "^7.52.0",
    "@wordpress/components": "^30.0.0",
    "@wordpress/dataviews": "^4.9.1",
    "@wordpress/element": "^6.0.0",
    "@wordpress/i18n": "^6.0.0",
    "@wordpress/icons": "^10.0.0",
    "@wordpress/scripts": "^30.0.0",
    "typescript": "~5.9.3"
  }
}
